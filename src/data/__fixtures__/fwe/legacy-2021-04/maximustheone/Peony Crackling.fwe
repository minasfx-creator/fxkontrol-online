<?xml version="1.0"?>
<FireworkEffect xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Children>
    <BaseEffectNode xsi:type="Shell">
      <Children>
        <BaseEffectNode xsi:type="BurstingCharge">
          <Children>
            <BaseEffectNode xsi:type="Stars">
              <Children>
                <BaseEffectNode xsi:type="Crackling">
                  <Children />
                </BaseEffectNode>
              </Children>
              <Type>Normal</Type>
              <Distribution xsi:type="SphericalDistribution">
                <Speed>1</Speed>
                <Sigma>0.04</Sigma>
              </Distribution>
              <Color>
                <CustomR>0</CustomR>
                <CustomG>0</CustomG>
                <CustomB>0</CustomB>
                <Color>Invisible</Color>
              </Color>
              <Count>200</Count>
              <MinimumLifetime>1.5</MinimumLifetime>
              <MaximumLifetime>2.1</MaximumLifetime>
              <Strobe>false</Strobe>
              <StrobeFreqMean>14</StrobeFreqMean>
            </BaseEffectNode>
          </Children>
          <Energy>80</Energy>
          <Delay>1.9</Delay>
        </BaseEffectNode>
      </Children>
      <Diameter>0.142</Diameter>
      <LiftingCharge>130</LiftingCharge>
    </BaseEffectNode>
  </Children>
  <Identifier>
    <Name>Peony Crackling</Name>
    <Author>maximus</Author>
  </Identifier>
  <AuthorSoftwareVersion>
    <Major>1</Major>
    <Minor>0</Minor>
  </AuthorSoftwareVersion>
</FireworkEffect>