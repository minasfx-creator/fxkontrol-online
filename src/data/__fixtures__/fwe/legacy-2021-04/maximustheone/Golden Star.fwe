<?xml version="1.0"?>
<FireworkEffect xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Children>
    <BaseEffectNode xsi:type="Shell">
      <Children>
        <BaseEffectNode xsi:type="BurstingCharge">
          <Children>
            <BaseEffectNode xsi:type="Stars">
              <Children>
                <BaseEffectNode xsi:type="StarTails">
                  <Children />
                  <Color>
                    <Color>Gold</Color>
                  </Color>
                  <Width>1.5</Width>
                  <EmitStart>0.0076</EmitStart>
                  <EmitEnd>0.3333</EmitEnd>
                  <Density>35</Density>
                </BaseEffectNode>
              </Children>
              <Type>Normal</Type>
              <Distribution xsi:type="SphericalDistribution">
                <Speed>1</Speed>
                <Sigma>0.1</Sigma>
              </Distribution>
              <Color>
                <Color>Invisible</Color>
              </Color>
              <Count>73</Count>
              <MinimumLifetime>5</MinimumLifetime>
              <MaximumLifetime>7</MaximumLifetime>
              <Strobe>false</Strobe>
            </BaseEffectNode>
          </Children>
          <Energy>117.95</Energy>
          <Delay>2.0872</Delay>
        </BaseEffectNode>
      </Children>
      <Diameter>0.142</Diameter>
      <LiftingCharge>130</LiftingCharge>
    </BaseEffectNode>
  </Children>
  <Identifier>
