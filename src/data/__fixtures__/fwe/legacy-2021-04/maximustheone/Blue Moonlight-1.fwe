<?xml version="1.0"?>
<FireworkEffect xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Children>
    <BaseEffectNode xsi:type="Shell">
      <Children>
        <BaseEffectNode xsi:type="BurstingCharge">
          <Children>
            <BaseEffectNode xsi:type="Stars">
              <Children>
                <BaseEffectNode xsi:type="StarTails">
                  <Children />
                  <Color>
                    <Color>Spark</Color>
                  </Color>
                  <Width>1.5</Width>
                  <EmitStart>0.05</EmitStart>
                  <EmitEnd>0.86</EmitEnd>
                  <Density>50</Density>
                </BaseEffectNode>
              </Children>
              <Type>Normal</Type>
              <Distribution xsi:type="AtomicPatternDistribution">
                <Speed>1</Speed>
                <Sigma>0.1</Sigma>
              </Distribution>
              <Color>
                <Color>Blue</Color>
              </Color>
              <Count>31</Count>
              <MinimumLifetime>1.5</MinimumLifetime>
              <MaximumLifetime>2.1</MaximumLifetime>
              <Strobe>false</Strobe>
