<?xml version="1.0"?>
<FireworkEffect xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Children>
    <BaseEffectNode xsi:type="Shell">
      <Children>
        <BaseEffectNode xsi:type="BurstingCharge">
          <Children>
            <BaseEffectNode xsi:type="Stars">
              <Children />
              <Type>Sparks</Type>
              <Distribution xsi:type="SphericalDistribution">
                <Speed>1</Speed>
                <Sigma>0.04</Sigma>
              </Distribution>
              <Color>
                <CustomR>255</CustomR>
                <CustomG>0</CustomG>
                <CustomB>255</CustomB>
                <Color>Custom</Color>
              </Color>
              <Count>200</Count>
              <MinimumLifetime>0.3</MinimumLifetime>
              <MaximumLifetime>1.5</MaximumLifetime>
              <Strobe>false</Strobe>
              <StrobeFreqMean>14</StrobeFreqMean>
            </BaseEffectNode>
          </Children>
          <Energy>27</Energy>
          <Delay>1.4</Delay>
        </BaseEffectNode>
      </Children>
      <Diameter>0.104</Diameter>
      <LiftingCharge>79</LiftingCharge>
    </BaseEffectNode>
  </Children>
  <Identifier>
    <Name>Battery Poeny small red</Name>
    <Author>maximus</Author>
  </Identifier>
  <AuthorSoftwareVersion>
    <Major>1</Major>
    <Minor>0</Minor>
  </AuthorSoftwareVersion>
</FireworkEffect>