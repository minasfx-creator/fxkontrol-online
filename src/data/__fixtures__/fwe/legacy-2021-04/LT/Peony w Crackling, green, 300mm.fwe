              <Distribution xsi:type="SphericalDistribution">
                <Speed>1</Speed>
                <Sigma>0.025718</Sigma>
              </Distribution>
              <Color>
                <Color>Green</Color>
              </Color>
              <Count>200</Count>
              <MinimumLifetime>3.0002</MinimumLifetime>
