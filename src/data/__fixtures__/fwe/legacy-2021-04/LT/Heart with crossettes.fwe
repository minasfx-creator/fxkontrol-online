<?xml version="1.0"?>
<FireworkEffect xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Children>
    <BaseEffectNode xsi:type="Shell">
      <Children>
        <BaseEffectNode xsi:type="BurstingCharge">
          <Children>
            <BaseEffectNode xsi:type="Stars">
              <Children>
                <BaseEffectNode xsi:type="Crossette">
                  <Children />
                  <Type>Normal</Type>
                  <Distribution xsi:type="SphericalDistribution">
                    <Speed>0.0669</Speed>
                    <Sigma>0.14</Sigma>
                  </Distribution>
                  <Color>
                    <CustomR>0</CustomR>
                    <CustomG>0</CustomG>
                    <CustomB>0</CustomB>
                    <Color>Yellow</Color>
                  </Color>
                  <Count>300</Count>
                  <MinimumLifetime>1.5</MinimumLifetime>
                  <MaximumLifetime>2.1</MaximumLifetime>
                  <Strobe>false</Strobe>
                  <StrobeFreqMean>14</StrobeFreqMean>
                </BaseEffectNode>
              </Children>
              <Type>Normal</Type>
              <Distribution xsi:type="HeartDistribution">
                <Speed>1</Speed>
                <Sigma>0.024234</Sigma>
              </Distribution>
              <Color>
                <CustomR>0</CustomR>
                <CustomG>0</CustomG>
                <CustomB>0</CustomB>
                <Color>Red</Color>
              </Color>
              <Count>75</Count>
              <MinimumLifetime>1.5</MinimumLifetime>
              <MaximumLifetime>2.1</MaximumLifetime>
              <Strobe>false</Strobe>
              <StrobeFreqMean>14</StrobeFreqMean>
            </BaseEffectNode>
          </Children>
          <Energy>80</Energy>
          <Delay>3.864</Delay>
        </BaseEffectNode>
      </Children>
      <Diameter>0.142</Diameter>
      <LiftingCharge>152</LiftingCharge>
    </BaseEffectNode>
  </Children>
  <Identifier>
    <Name>Heart with crossettes</Name>
    <Author>LT</Author>
  </Identifier>
  <AuthorSoftwareVersion>
    <Major>0</Major>
